// Osysharp.Shipping — the contract between an app that sends things and the carriers that carry them.
//
// A shop depends on THIS package and on no carrier in particular. Each way of getting goods to a customer — a flat
// rate, collection from the shop, PostNord, DHL, Sendcloud (many carriers behind one integration) — is a class
// implementing `IDeliveryProvider`: it quotes the options for a basket and an address, books a shipment when the
// goods go out, and says where the parcel is.
package Osysharp.Shipping {
  version "0.1.1";
  minPlatform "0.9.0";
  summary     "the delivery contract — quote, ship, track and carrier events — plus flat-rate delivery and collection.";
  model "model/*.osy";
  tests "tests";
}
